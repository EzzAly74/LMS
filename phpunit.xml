<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>
    <php>
        <!-- The suite runs ~370 tests in one process and its memory grows across
             them; the image-conversion tests (IMG-01) decode real bitmaps and tipped
             it past the 128M default. A web request starts fresh, so this raises the
             test runner's ceiling only. Isolated, those tests peak at 62 MB. -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="2b_academy_testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Tests must never call the real HR system (B-145): an address that cannot resolve; tests fake HRSystemService. -->
        <env name="HR_BASE_URL" value="http://hr.invalid/"/>
        <env name="HR_ADMIN_EMAIL" value=""/>
        <env name="HR_ADMIN_PASSWORD" value=""/>
    </php>
</phpunit>
